    target_support_id
  }

  checks {
    `("target_uma_id" IS NULL OR "target_support_id" IS NULL)` [name: 'at_most_one_selector_target']
  }

  Note: 'Django model: calculatorapi.UserPlannedPurchase. Source: calculatorapi/models/user_planned_purchase.py. At most one selector target may be set; neither is valid for an unchosen target or a carat pack.'
}

Table calculatorapi_userstepupselection as UserStepUpSelection {
  id bigint [pk, increment, not null]
  user_id bigint [not null, note: 'Django on_delete: CASCADE.']
  banner_step_up_id bigint [not null, note: 'Django on_delete: CASCADE.']
  uma_id bigint [null, note: 'Django on_delete: CASCADE.']
  support_id bigint [null, note: 'Django on_delete: CASCADE.']
  slot integer [not null, check: `"slot" >= 0`, note: 'Which of the 10 selection slots, 1-based.']
  is_target boolean [not null, note: 'Django default: False. The step 5 pick -- the copy the player chooses outright.']

  indexes {
    (user_id, banner_step_up_id, slot) [unique, name: 'unique_step_up_selection_slot']
    user_id
    banner_step_up_id
    uma_id
    support_id
  }

  checks {
    `(("support_id" IS NULL AND "uma_id" IS NOT NULL) OR ("support_id" IS NOT NULL AND "uma_id" IS NULL))` [name: 'exactly_one_selection_card']
  }

  Note: 'Django model: calculatorapi.UserStepUpSelection. Source: calculatorapi/models/user_step_up_selection.py. One filled slot per user and step-up. Slots 1..10 and matching card_type are validated in application code. Selections survive deleting a planned banner. An empty slot has no row. Partial unique index one_step_up_target_per_banner: UNIQUE (user_id, banner_step_up_id) WHERE "is_target".'
}

