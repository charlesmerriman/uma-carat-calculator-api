  name varchar(255) [not null]
  admin_comments text [null, note: 'Notes for editors.']
  free_pulls integer [not null, note: 'Django default: 0. Free pulls players get on this banner — the calculator counts these toward affordability.']
  is_recommended boolean [not null, note: 'Django default: False. Tick when this banner is exceptionally worth pulling on. Highlights it on the Timeline and in the calculator\'s banner dropdown.']

