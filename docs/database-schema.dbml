}

Table django_admin_log as LogEntry {
  id integer [pk, increment, not null]
  action_time "timestamp with time zone" [not null, note: 'Django default: django.utils.timezone.now().']
  user_id bigint [not null, note: 'Django on_delete: CASCADE.']
  content_type_id integer [null, note: 'Django on_delete: SET_NULL.']
  object_id text [null]
  object_repr varchar(200) [not null]
  action_flag smallint [not null, check: `"action_flag" >= 0`, note: 'Django choices: 1 (Addition); 2 (Change); 3 (Deletion).']
  change_message text [not null]

  indexes {
    user_id
    content_type_id
  }

  Note: 'Django model: admin.LogEntry. Django admin audit log. object_id identifies an object of content_type; it is a generic identifier, not a database FK to that object.'
}

Table django_session as Session {
  session_key varchar(40) [pk, not null]
  session_data text [not null]
  expire_date "timestamp with time zone" [not null]

  indexes {
    expire_date
  }

  Note: 'Django model: sessions.Session.'
}

Table django_migrations as Migration {
  id bigint [pk, increment, not null]
  app varchar(255) [not null]
  name varchar(255) [not null]
  applied "timestamp with time zone" [not null, note: 'Django default: django.utils.timezone.now().']

  Note: 'Django model: migrations.Migration. Django migration bookkeeping model, included explicitly because it lives outside the installed-app model registry.'
}

