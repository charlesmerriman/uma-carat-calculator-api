Table calculatorapi_userplannedbanner as UserPlannedBanner {
  id bigint [pk, increment, not null]
  user_id bigint [not null, note: 'Django on_delete: CASCADE.']
  banner_uma_id bigint [null, note: 'Django on_delete: CASCADE.']
  banner_support_id bigint [null, note: 'Django on_delete: CASCADE.']
  banner_step_up_id bigint [null, note: 'Django on_delete: CASCADE.']
  number_of_pulls integer [not null]
  reserved_copies integer [not null, note: 'Django default: 0.']
  note text [not null, note: 'Django default: empty string. Owner-only free text; 500-char cap enforced by the serializer.']

  indexes {
    user_id
    banner_uma_id
    banner_support_id
    banner_step_up_id
  }

  checks {
    `(("banner_step_up_id" IS NULL AND "banner_support_id" IS NULL AND "banner_uma_id" IS NOT NULL) OR ("banner_step_up_id" IS NULL AND "banner_support_id" IS NOT NULL AND "banner_uma_id" IS NULL) OR ("banner_step_up_id" IS NOT NULL AND "banner_support_id" IS NULL AND "banner_uma_id" IS NULL))` [name: 'exactly_one_banner_target']
  }

  Note: 'Django model: calculatorapi.UserPlannedBanner. Source: calculatorapi/models/user_planned_banner.py. Exactly one of the three banner FKs must be set. number_of_pulls stores STEPS for step-up rows and pulls otherwise. reserved_copies are copies obtained without pulling.'
}

