Table calculatorapi_bannerstepup as BannerStepUp {
  id bigint [pk, increment, not null]
  banner_timeline_id bigint [not null, note: 'The campaign part this step-up runs alongside — normally Part 2. Supplies the dates the projection uses. Django on_delete: CASCADE.']
  anniversary_event_id bigint [not null, note: 'The campaign selling it. Supplies the JP cutoff for candidates. Django on_delete: CASCADE.']
  name varchar(255) [not null, note: 'As shown on the planner, e.g. \'5th Anniversary SSR Select Step-Up\'.']
  card_type varchar(10) [not null, note: 'Django default: "support". Django choices: uma (★3 Uma); support (SSR Support). Which pool this step-up draws from. Drives the odds labels.']
  banner_count integer [not null, check: `"banner_count" >= 0`, note: 'Django default: 1. How many banners of this card type the campaign sells. This is the hard ceiling on steps: banner_count x 5. Application validator: MinValueValidator(1).']
  image varchar(100) [null, note: 'Stored file path, not binary image data.']
  admin_comments text [null, note: 'Notes for editors.']
  order integer [not null, check: `"order" >= 0`, note: 'Django default: 0. Sort order within a campaign, e.g. to put ★3 before SSR.']

  indexes {
    banner_timeline_id
    anniversary_event_id
  }

  Note: 'Django model: calculatorapi.BannerStepUp. Source: calculatorapi/models/banner_step_up.py. Paid-carats-only ladder. max_steps = banner_count * 5 is computed, not stored. Application validation requires banner_timeline to be a part of anniversary_event.'
}

Table calculatorapi_uma as Uma {
  id bigint [pk, increment, not null]
  name varchar(255) [not null]
  image varchar(100) [null, note: 'Stored file path, not binary image data.']
  admin_comments text [null, note: 'Notes for editors.']
  purpose varchar(100) [not null, note: 'Django default: "". Shown publicly when a player hovers this uma\'s art on the Timeline, e.g. "Great pace parent." Leave blank to show nothing. Notes for other editors go in Admin comments instead.']
  is_time_limited boolean [not null, note: 'Django default: False. Only obtainable during a limited window, so selector tickets and step-ups can never take them. Hides this uma from every selector picker and stops a selector funding a banner it is featured on.']
  rarity smallint [null, note: 'Django choices: 1 (★1); 2 (★2); 3 (★3). Initial star count. The ★ half of the intrinsic selector gate, read through the Uma.is_three_star property; null counts as ★3. Imported for umas on global, set by hand otherwise. The other imported game-data columns are not listed in this file.']

  Note: 'Django model: calculatorapi.Uma. Source: calculatorapi/models/uma.py.'
}

