  rarity smallint [null, note: 'Django choices: 1 (R); 2 (SR); 3 (SSR). Imported; otherwise read off the first digit of game_id on save. Null only for a card with no game id.']

  Note: 'Django model: calculatorapi.SupportCard. Source: calculatorapi/models/support_card.py.'
}

