// Banners and Cards

Table calculatorapi_bannertimeline as BannerTimeline {
  id bigint [pk, increment, not null]
  name varchar(255) [not null]
  banner_category varchar(32) [not null, note: 'Django default: "standard". Django choices: standard (Standard); race_prep_support (Race prep support rerun); golden_week_revival (Golden Week revival); rerun (Rerun). What kind of banner window this is. Drives the timeline card\'s layout and the category filter. Leave as Standard unless this is a revival, a rerun, or a race-prep support batch.']
  jp_start_date "timestamp with time zone" [null]
  jp_end_date "timestamp with time zone" [null]
  global_start_date "timestamp with time zone" [null]
  global_end_date "timestamp with time zone" [null]
  schedule_offset_days integer [not null, note: 'Django default: 0. Days to push this and every later date forward. Leave at 0 unless global has slipped its schedule. Ignored once global dates are confirmed.']
  image varchar(100) [null, note: 'Stored file path, not binary image data.']

  Note: 'Django model: calculatorapi.BannerTimeline. Source: calculatorapi/models/banner_timeline.py. Stores JP dates and confirmed global dates. Effective start/end dates and applied schedule offsets are computed. banner_category is separate from a planner row kind (Uma, Support, Step Up).'
}

Table calculatorapi_banneruma as BannerUma {
