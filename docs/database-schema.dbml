// Configuration and Changelog

Table calculatorapi_calculationconstants as CalculationConstants {
  id bigint [pk, increment, not null]
  daily_base_carats integer [not null, note: 'Django default: 75. Carats from daily quests, every day. Sheet: the 75 in AN42. Application validator: MinValueValidator(0).']
  weekly_bonus_carats integer [not null, note: 'Django default: 150. TOTAL login bonus carats per week, spread evenly across the seven days rather than paid on specific ones. Sheet: the 150 in AN42\'s 75 + 150/7. Application validator: MinValueValidator(0).']
  daily_carat_pack_per_day integer [not null, note: 'Django default: 50. Daily Carat Pack drip, credited as FREE carats. Sheet: AR42. Application validator: MinValueValidator(0).']
  daily_carat_pack_paid_carats integer [not null, note: 'Django default: 500. Daily Carat Pack repurchase bonus, credited as PAID carats — the balance that funds discounted pulls. Sheet: AZ42. Application validator: MinValueValidator(0).']
  daily_carat_pack_cycle_days integer [not null, note: 'Django default: 30. Days between Daily Carat Pack repurchases. Application validator: MinValueValidator(1).']
  training_pass_start_date date [not null, note: 'Django default: "2027-08-15". The date the Training Pass feature launches on Global. Nothing is earned from it before this.']
  training_pass_monthly_free_carats integer [not null, note: 'Django default: 1850. FREE half of the paid Training Pass\'s monthly carats. With the paid half below this totals the pass\'s headline figure. Sheet: AQ42. Application validator: MinValueValidator(0).']
  training_pass_monthly_paid_carats integer [not null, note: 'Django default: 350. PAID half of the paid Training Pass\'s monthly carats. Sheet: BA42. Application validator: MinValueValidator(0).']
  monthly_base_reward integer [not null, note: 'Django default: 500. Monthly carats for an account WITHOUT the paid Training Pass. Replaced by the paid figures above, never added to them. Application validator: MinValueValidator(0).']
  training_pass_free_uma_tickets integer [not null, note: 'Django default: 2. Monthly uma tickets every account gets once the pass launches. Application validator: MinValueValidator(0).']
  training_pass_free_support_tickets integer [not null, note: 'Django default: 2. Monthly support tickets every account gets once the pass launches. Application validator: MinValueValidator(0).']
  training_pass_paid_bonus_uma_tickets integer [not null, note: 'Django default: 2. EXTRA monthly uma tickets from the paid pass, added to the free tier\'s. Application validator: MinValueValidator(0).']
  training_pass_paid_bonus_support_tickets integer [not null, note: 'Django default: 2. EXTRA monthly support tickets from the paid pass, added to the free tier\'s. Application validator: MinValueValidator(0).']
  training_pass_paid_ssr_shards integer [not null, note: 'Django default: 1. Monthly SSR uncap shards from an ACTIVE paid Training Pass. The free tier earns none, so unlike the tickets above there is no free counterpart to add this to. Delivered on the same monthly clock as the pass\'s carats and tickets. Application validator: MinValueValidator(0).']
  misc_earnings_monthly integer [not null, note: 'Django default: 1800. Monthly approximation of gifts, career and Team Trials extras, dripped daily as monthly/30. Toggled per user. The live value is 2700 (90 a day), set here in the admin; this field default is only what a fresh database starts from. For reference the source sheet\'s own figure (Timeline!AW1) is 3000. Application validator: MinValueValidator(0).']
  misc_earnings_delay_days integer [not null, note: 'Django default: 30. Ramp-in before misc earnings start, counted from today. Sheet: AV42. Application validator: MinValueValidator(0).']
  fifty_day_login_carats integer [not null, note: 'Django default: 150. Carats per completed login-campaign cycle. Sheet: AU42. Application validator: MinValueValidator(0).']
  fifty_day_login_cycle_days integer [not null, note: 'Django default: 50. Length of that login campaign cycle, in days. Application validator: MinValueValidator(1).']
  valentines_carats integer [not null, note: 'Django default: 500. Valentine\'s Day gift. Universal — no toggle. Application validator: MinValueValidator(0).']
  valentines_month integer [not null, note: 'Django default: 2. Month of the Valentine\'s gift, 1-12. Application validator: MinValueValidator(1). Application validator: MaxValueValidator(12).']
  valentines_day integer [not null, note: 'Django default: 14. Day of month of the Valentine\'s gift. Application validator: MinValueValidator(1). Application validator: MaxValueValidator(31).']
  white_day_carats integer [not null, note: 'Django default: 500. White Day gift. Universal — no toggle. Application validator: MinValueValidator(0).']
  white_day_month integer [not null, note: 'Django default: 3. Month of the White Day gift, 1-12. Application validator: MinValueValidator(1). Application validator: MaxValueValidator(12).']
  white_day_day integer [not null, note: 'Django default: 14. Day of month of the White Day gift. Application validator: MinValueValidator(1). Application validator: MaxValueValidator(31).']
  monthly_shop_uma_tickets integer [not null, note: 'Django default: 4. Uma tickets in the monthly shop bundle. Off by default per user. Application validator: MinValueValidator(0).']
  monthly_shop_support_tickets integer [not null, note: 'Django default: 4. Support tickets in the monthly shop bundle. Application validator: MinValueValidator(0).']
  monthly_shop_restock_day integer [not null, note: 'Django default: 2. Day of month the shop restocks. Counting from here rather than the 1st stops a banner ending on the 1st being credited a bundle the player cannot buy yet. Sheet: BG42. Application validator: MinValueValidator(1). Application validator: MaxValueValidator(28).']
  pull_cost_carats integer [not null, note: 'Django default: 150. Carats per full-price pull. Application validator: MinValueValidator(1).']
  discounted_pull_cost_carats integer [not null, note: 'Django default: 50. Carats per discounted pull. PAID carats only, and capped at one per day of a banner\'s run. Application validator: MinValueValidator(1).']
  shards_per_crystal integer [not null, note: 'Django default: 20. Shards that combine into one uncap crystal. Application validator: MinValueValidator(1).']
  step_up_cost_step_1 integer [not null, note: 'Django default: 500. Paid carats for step 1 of a Select Step-Up ladder. Sheet: AL360. Application validator: MinValueValidator(0).']
  step_up_cost_step_2 integer [not null, note: 'Django default: 700. Paid carats for step 2. Application validator: MinValueValidator(0).']
  step_up_cost_step_3 integer [not null, note: 'Django default: 1000. Paid carats for step 3 (first guaranteed card). Application validator: MinValueValidator(0).']
  step_up_cost_step_4 integer [not null, note: 'Django default: 1300. Paid carats for step 4 (second guaranteed card). Application validator: MinValueValidator(0).']
  step_up_cost_step_5 integer [not null, note: 'Django default: 1500. Paid carats for step 5, where the player CHOOSES the guaranteed card. The five together total 5,000 for one completed banner. Application validator: MinValueValidator(0).']
  step_up_pulls_per_step integer [not null, note: 'Django default: 10. Pulls per step. Each step is a 10-pull. Application validator: MinValueValidator(1).']
  step_up_target_rate numeric(6,4) [not null, note: 'Django default: "0.0030". Per-pull chance of the ONE card the player is chasing. Derived: the game\'s ~3% total ★3/SSR rate spread across the 10 cards they selected. Change it only if the pool size or the headline rate changes — it is not an independent dial. Application validator: MinValueValidator(0). Application validator: MaxValueValidator(1).']
  step_up_max_rounds integer [not null, note: 'Django default: 7. Safety bound on completed ladders, NOT the live constraint. Real cost and odds clamp at a banner\'s own banner_count x 5, which is always lower. The source sheet\'s 35-step cap is an artifact of its lookup table\'s extent rather than a game rule. Application validator: MinValueValidator(1).']
  throughout_end_offset_days integer [not null, note: 'Django default: 4. Days trimmed off a banner\'s end before the decay curve is measured. Sheet: end_date - (\'Carat Calculator\'!G25 + 1). Application validator: MinValueValidator(0).']
  throughout_filter_grace_days integer [not null, note: 'Django default: 4. Grace window deciding which banners can still reach an event\'s throughout carats. Sheet: AQ32, which reads 3 — ours was fitted to 4 against published per-banner figures, so one of the offsets above may be absorbing a day. Confirm with the parity harness before treating either as authoritative. Application validator: MinValueValidator(0).']
  throughout_decay_k numeric(4,2) [not null, note: 'Django default: "2.00". Steepness of the curve\'s early exponential leg. Higher front-loads more of the pool into the first days of a banner. Application validator: MinValueValidator(0).']
  throughout_decay_linear_slope numeric(4,2) [not null, note: 'Django default: "0.80". Slope of the curve\'s slower linear leg, which governs the tail. Application validator: MinValueValidator(0).']
  prediction_factor numeric(5,3) [not null, note: 'Django default: "0.664". Global covers JP\'s back catalogue faster than real time; each day of JP gap maps to this many days of Global gap. Raising it pushes every unconfirmed banner LATER. Retune if the observed cadence shifts. Application validator: MinValueValidator(0). Application validator: MaxValueValidator(2).']
  game_event_end_buffer_days integer [not null, note: 'Django default: 4. Days a game event\'s end trails its linked banner\'s end by. Used both to date events and to recover the banner window the decay curve runs over. Application validator: MinValueValidator(0).']

  Note: 'Django model: calculatorapi.CalculationConstants. Source: calculatorapi/models/calculation_constants.py. Singleton: model save() pins pk=1 and instance delete() does nothing. These are application rules, not database check constraints.'
}

Table calculatorapi_changelogentry as ChangelogEntry {
  id bigint [pk, increment, not null]
  title varchar(255) [not null]
  version varchar(50) [not null]
  date date [not null]
  key varchar(100) [null, unique, note: 'Leave blank. A key means this entry is written in the repository (calculatorapi/data/changelog.yaml) and edits made here are replaced on the next deploy — edit the file instead.']

  Note: 'Django model: calculatorapi.ChangelogEntry. Source: calculatorapi/models/changelog_entry.py.'
}

Table calculatorapi_changelogchange as ChangelogChange {
  id bigint [pk, increment, not null]
  entry_id bigint [not null, note: 'Django on_delete: CASCADE.']
  category varchar(10) [not null, note: 'Django default: "changed". Django choices: added (Added); fixed (Fixed); changed (Changed).']
  text varchar(500) [not null]
  order integer [not null, check: `"order" >= 0`, note: 'Django default: 0.']

  indexes {
    entry_id
  }

  Note: 'Django model: calculatorapi.ChangelogChange. Source: calculatorapi/models/changelog_change.py.'
}

// Patreon

Table calculatorapi_patreontier as PatreonTier {
  id bigint [pk, increment, not null]
  name varchar(50) [not null, unique]
  order smallint [not null, check: `"order" >= 0`, note: 'Django default: 0. Lower numbers appear first on the site. Ties fall back to name.']

  Note: 'Django model: calculatorapi.PatreonTier. Source: calculatorapi/models/patreon_tier.py.'
}

Table calculatorapi_patreonsupporter as PatreonSupporter {
  id bigint [pk, increment, not null]
  display_name varchar(100) [not null, note: 'The name to thank them by. Use their Patreon handle, never a billing name.']
  email varchar(254) [not null, note: 'Django default: "". Admin only — never shown on the website. Used to tell supporters with similar or changed display names apart.']
  patreon_user_id varchar(64) [not null, note: 'Django default: "". Admin only — never shown on the website. Patreon\'s own id for this person; filled by the API sync and used to match them to a site account.']
  linked_user_id bigint [null, unique, note: 'The site account this patron signed in with, if they have linked one. Django on_delete: SET_NULL.']
  tier_id bigint [null, note: 'Django on_delete: SET_NULL.']
  is_public boolean [not null, note: 'Django default: False. Off by default. While off they are counted anonymously instead. Only tick this for a name they chose to be shown by.']
  is_active boolean [not null, note: 'Django default: True. Untick when a pledge lapses. Keeps the row instead of deleting it.']
  patron_since date [null, note: 'Optional. Used only to order supporters within a tier, longest-standing first.']

  indexes {
    tier_id
  }

  Note: 'Django model: calculatorapi.PatreonSupporter. Source: calculatorapi/models/patreon_supporter.py. linked_user is optional and one-to-one. Account or tier deletion preserves the supporter. Entitlement is derived from linked_user, is_active and tier. patreon_user_id is matched to SocialAccount.subject_id for provider=patreon in application code; there is no FK between those strings. Partial unique index unique_patreon_supporter_patreon_user_id: UNIQUE (patreon_user_id) WHERE NOT ("patreon_user_id" = \'\'). Partial unique index unique_patreon_supporter_display_name: UNIQUE (LOWER("display_name")) WHERE "patreon_user_id" = \'\'.'
}

Table calculatorapi_patreoncredentials as PatreonCredentials {
  id bigint [pk, increment, not null]
  access_token varchar(255) [not null, note: 'Django default: "". Current Patreon access token. Rotated automatically; do not edit.']
  refresh_token varchar(255) [not null, note: 'Django default: "". Used to mint the next access token. Single-use — rotated on every refresh.']
  expires_at "timestamp with time zone" [null, note: 'When the current access token stops working.']
  campaign_id varchar(64) [not null, note: 'Django default: "". Resolved from the API on first use and cached here.']
  last_synced_at "timestamp with time zone" [null, note: 'Last time a sync completed and wrote changes.']
  last_sync_error text [not null, note: 'Django default: "". Message from the last failed sync. Cleared when one succeeds.']

  Note: 'Django model: calculatorapi.PatreonCredentials. Source: calculatorapi/models/patreon_credentials.py. Singleton: model save() pins pk=1 and instance delete() does nothing. Stores the rotating credential pair; never registered in admin. This diagram includes field definitions only.'
}

// Analytics

Table calculatorapi_dailyvisit as DailyVisit {
  id bigint [pk, increment, not null]
  date date [not null, unique]
  page_views integer [not null, check: `"page_views" >= 0`, note: 'Django default: 0.']
  unique_visitors integer [not null, check: `"unique_visitors" >= 0`, note: 'Django default: 0.']

  Note: 'Django model: calculatorapi.DailyVisit. Source: calculatorapi/models/site_visit.py. Permanent daily aggregate counters; no relationship to individual users.'
}

Table calculatorapi_monthlyvisit as MonthlyVisit {
  id bigint [pk, increment, not null]
  month date [not null, unique]
  page_views integer [not null, check: `"page_views" >= 0`, note: 'Django default: 0.']
  unique_visitors integer [not null, check: `"unique_visitors" >= 0`, note: 'Django default: 0.']

  Note: 'Django model: calculatorapi.MonthlyVisit. Source: calculatorapi/models/site_visit.py. Permanent monthly aggregate counters. month represents the first day of the month. Monthly uniques are not the sum of daily uniques.'
}

Table calculatorapi_visitorhash as VisitorHash {
  id bigint [pk, increment, not null]
  date date [not null]
  visitor_hash varchar(32) [not null]

  indexes {
    (visitor_hash, date) [name: 'visitor_hash_date_idx']
    (date, visitor_hash) [unique, name: 'unique_visitor_hash_per_day']
    date
    visitor_hash
  }

  Note: 'Django model: calculatorapi.VisitorHash. Source: calculatorapi/models/site_visit.py. Temporary visitor deduplication rows. Stores month-scoped salted digests, not IP addresses. No user FK.'
}

