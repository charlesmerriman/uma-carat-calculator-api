# Copy to .env and fill in. .env is gitignored; this file documents the shape.

# --- Core --------------------------------------------------------------------
DEBUG=True
# Required in production. Locally it falls back to an insecure default.
DJANGO_SECRET_KEY=
# Comma-separated. Defaults to localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
# PostgreSQL connection string. Falls back to db.sqlite3 when unset.
DATABASE_URL=

# --- Frontend origin ---------------------------------------------------------
# The backend derives OAUTH_REDIRECT_URI as "<FRONTEND_URL>/auth/callback".
# That value must match what is registered in the provider consoles EXACTLY,
# including scheme and the absence of a trailing slash.
FRONTEND_URL=http://localhost:5173

# Extra redirect URIs /auth/<provider>/start will accept when the SPA asks for
# one by name, on top of the derived OAUTH_REDIRECT_URI above. Comma-separated.
#
# Leave this BLANK locally: FRONTEND_URL is already localhost, so the derived
# URI covers you. It exists for DEPLOYED apps, where setting
#   http://localhost:5173/auth/callback
# lets `npm run dev:live` complete a real sign-in against that deployment
# instead of bouncing the developer to the deployed site.
#
# Setting this on a public deployment is a deliberate decision: it permits that
# app to hand authorization codes to a loopback address. Entries must be
# byte-exact and registered in the provider console. Unlisted values are
# refused, which is what stops this being an open redirector.
OAUTH_EXTRA_REDIRECT_URIS=

# Comma-separated origins allowed to call the API cross-origin.
CORS_ORIGIN_WHITELIST=http://localhost:5173

# The path the public ingress serves this API under: /api in production. Leave
# it BLANK locally, where runserver is the whole origin. Only the OpenAPI schema
# reads it, so that Swagger UI's "Try it out" calls the API rather than the SPA.
API_PUBLIC_PREFIX=

# --- Social sign-in ----------------------------------------------------------
# Google:  console.cloud.google.com -> APIs & Services -> Credentials
#          -> OAuth 2.0 Client ID (Web application)
# Discord: discord.com/developers/applications -> your app -> OAuth2
#
# Register BOTH redirect URIs in each console:
#   http://localhost:5173/auth/callback
#   https://<your-production-host>/auth/callback
# (Google permits plain http only for localhost.)
#
# Scopes are set in code to the narrowest each provider allows — "openid" for
# Google, "identify" for Discord, "identity" for Patreon — so no email address is
# ever sent to us. Patreon's email lives behind a SEPARATE "identity[email]"
# scope which we must never request.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# ⚠️ NOT the same as PATREON_CLIENT_ID below — read both comments.
# This pair is the SIGN-IN app: it acts for a visitor who consents to it, and
# yields one opaque Patreon user id. The pair further down is the CREATOR app,
# which acts for the site owner and reads our campaign's member list. Same
# provider, different jobs; wiring one where the other belongs fails in a way
# that looks like an outage rather than a config mistake.
PATREON_OAUTH_CLIENT_ID=
PATREON_OAUTH_CLIENT_SECRET=

# --- Patreon supporters sync (CREATOR app — not the sign-in pair above) -------
# Register a client at patreon.com/portal/registration/register-clients. It issues
# the client id/secret AND a creator access + refresh token for your own account.
#
# NOTE: there are no scopes to choose. A creator access token automatically
# carries every v2 scope, so this token CAN read patron emails and postal
# addresses. The only thing that stops it is MEMBER_FIELDS in
# calculatorapi/patreon_api.py, which names the four fields we request. Treat
# that list as the privacy boundary it is.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# SEED VALUES ONLY. Patreon rotates both tokens on every refresh, so the current
# pair lives on the PatreonCredentials row; these are read once to fill an empty
# row and ignored from then on. Leaving them here stale is harmless.
PATREON_ACCESS_TOKEN=
PATREON_REFRESH_TOKEN=

# Shared secret for POST /patreon/sync, which the daily GitHub Action calls. Any
# long random string; it must match the repo secret byte-for-byte. While this is
# blank the endpoint returns 404 and the scheduled sync is simply off.
PATREON_SYNC_SECRET=

# --- "Rebuild website" button (admin -> Site content -> Pages) ----------------
# A personal access token scoped to apps, and this app's id (`doctl apps list`).
# Both blank locally: the button then says it is not configured and does
# nothing. Set on the API component in production so an editor can rebuild the
# static site after editing the pages or the FAQ.
DO_API_TOKEN=
DO_APP_ID=

# --- DigitalOcean Spaces (media storage) -------------------------------------
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_BUCKET_NAME=
DO_SPACES_ENDPOINT_URL=
DO_SPACES_CDN_DOMAIN=
